# =============================================================================
# PersonaBot — Environment Configuration Example
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================


# =============================================================================
# AI PROVIDER  [REQUIRED]
# Controls which backend is used for persona/answer generation (phases 2 & 3).
# "gemini" → Google Gemini API
# "vllm"   → your vLLM server (or any OpenAI-compatible endpoint)
# =============================================================================

AI_PROVIDER="gemini"

# --- Gemini settings (used when AI_PROVIDER=gemini) ---
# Get keys from: https://aistudio.google.com/app/apikey
# Add _2, _3, … for round-robin rotation across rate-limit quotas.
GEMINI_API_KEY_1="your_gemini_api_key_here"
# GEMINI_API_KEY_2="your_second_key_here"
GEMINI_MODEL_NAME="gemini-2.5-pro"

# --- vLLM settings (used when AI_PROVIDER=vllm) ---
# If the server is remote, forward the port first:
#   ssh -L 8000:localhost:8000 user@your-server
# Find your model name: curl http://localhost:8000/v1/models
VLLM_BASE_URL="http://localhost:8000/v1"
VLLM_MODEL_NAME="your-model-name-here"
VLLM_API_KEY="EMPTY"

# Delay (seconds) between consecutive AI calls.
# Gemini free tier needs ~20s. Local vLLM: 0.
AI_CALL_DELAY_SECONDS="0"


# =============================================================================
# FORM URL  [REQUIRED]
# The full URL of the online survey to automate.
# =============================================================================

BASE_FORM_URL=""


# =============================================================================
# BROWSER SETTINGS  [OPTIONAL]
# HEADLESS_MODE: True = run in background (faster), False = show browser window
# SLOW_MO: ms delay between Playwright actions (0 = fastest, 200+ = human-like)
# BROWSER_CHANNEL: "chrome" uses system Google Chrome (required on Ubuntu 26+)
#                  leave empty to use Playwright's bundled Chromium
# =============================================================================

HEADLESS_MODE="True"
SLOW_MO="50"
BROWSER_CHANNEL="chrome"


# =============================================================================
# TOR NETWORK  [OPTIONAL — for IP rotation between submissions]
# Requires Tor: sudo apt install tor && sudo service tor start
# =============================================================================

USE_TOR="False"
TOR_SOCKS_HOST="127.0.0.1"
TOR_SOCKS_PORT="9050"
TOR_CONTROL_PORT="9051"
TOR_CONTROL_PASSWORD=""


# =============================================================================
# OUTPUT DIRECTORY  [OPTIONAL — default: output/]
# =============================================================================

OUTPUT_DIR="output"
